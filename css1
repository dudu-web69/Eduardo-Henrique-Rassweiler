body {
    background-color: #eae6dc;
    font-family: 'Georgia', serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
  }
   
  .card {
    width: 320px;
    background-color: #ffffff;
    border: 2px solid #000000;
    border-radius: 6px;
    box-shadow: 0 6px 15px rgba(0,0,0,0.3);
    overflow: hidden;
    position: relative;
  }
   
  .card img {
    width: 100%;
    display: block;
    border-bottom: 2px solid #000000;
  }
